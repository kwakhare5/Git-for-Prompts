{
  "openapi": "3.1.0",
  "info": {
    "title": "Git for Prompts REST API",
    "version": "1.0.0",
    "description": "Local-first prompt package manager and version control for AI engineering. Programmatic access to prompts, versions, and test suites.",
    "contact": {
      "name": "Git for Prompts Support",
      "email": "support@gitforprompts.org",
      "url": "https://gitforprompts.vercel.app/contact"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/kwakhare5/Git-for-Prompts/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://gitforprompts.vercel.app/api/v1",
      "description": "Production Vercel API"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/prompts": {
      "get": {
        "summary": "List prompt repositories",
        "description": "Retrieve all prompt repositories accessible to the authenticated user.",
        "operationId": "listPrompts",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of prompts to return (1-100)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of prompt repositories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "prompts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PromptSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Create prompt repository",
        "description": "Initialize a new prompt repository with an initial version snapshot.",
        "operationId": "createPrompt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePromptInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Prompt created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "prompt": {
                      "$ref": "#/components/schemas/PromptSummary"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/prompts/{id}/latest": {
      "get": {
        "summary": "Get latest prompt version snapshot",
        "description": "Fetch the latest immutable version snapshot of a prompt repository including system prompt, user template, and model hyperparameter configuration.",
        "operationId": "getLatestPromptVersion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique prompt repository ID or UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The latest active prompt version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "prompt": {
                      "$ref": "#/components/schemas/PromptSummary"
                    },
                    "version": {
                      "$ref": "#/components/schemas/PromptVersion"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/prompts/{id}/versions": {
      "get": {
        "summary": "List prompt version history",
        "description": "Fetch the chronological, immutable version commit history of a prompt.",
        "operationId": "listPromptVersions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique prompt repository ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of historical prompt versions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "versions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PromptVersion"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Git for Prompts API key (e.g. gfp_live_... or gfp_test_...)"
      }
    },
    "schemas": {
      "PromptSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "currentVersionId": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name"]
      },
      "PromptVersion": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "versionNumber": { "type": "integer" },
          "commitMessage": { "type": ["string", "null"] },
          "systemPrompt": { "type": "string" },
          "userTemplate": { "type": "string" },
          "modelProvider": { "type": "string", "enum": ["groq", "openrouter", "openai", "anthropic"] },
          "modelName": { "type": "string" },
          "temperature": { "type": "string" },
          "topP": { "type": "string" },
          "maxTokens": { "type": "integer" },
          "responseFormat": { "type": ["object", "null"] },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "versionNumber", "systemPrompt", "userTemplate", "modelProvider", "modelName"]
      },
      "CreatePromptInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Unique prompt name" },
          "description": { "type": "string" },
          "systemPrompt": { "type": "string" },
          "userTemplate": { "type": "string" },
          "modelProvider": { "type": "string", "default": "groq" },
          "modelName": { "type": "string", "default": "llama-3.3-70b-versatile" },
          "temperature": { "type": "number", "default": 0.2 },
          "topP": { "type": "number", "default": 0.95 },
          "maxTokens": { "type": "integer", "default": 2048 }
        },
        "required": ["name", "systemPrompt"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" }
        },
        "required": ["error"]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid Bearer authentication key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Validation failure or malformed payload",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Prompt repository or version not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
