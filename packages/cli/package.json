{
  "name": "gitforprompts",
  "version": "0.1.3",
  "description": "Git for Prompts CLI — local-first prompt package manager with SQLite storage",
  "type": "module",
  "bin": {
    "gitforprompts": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --no-splitting --clean",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@gfp/core": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/sql.js": "^1.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwakhare5/git-for-prompts.git"
  },
  "homepage": "https://gitforprompts.vercel.app",
  "keywords": [
    "gitforprompts",
    "prompt-engineering",
    "llm",
    "prompt-version-control",
    "local-first",
    "evals"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
