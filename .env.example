# AI Providers (Groq is Primary, OpenRouter is Fallback)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: Configurable AI Evaluator Models
# If unset, execution models are used for evaluation as well.
# GROQ_EXECUTION_MODEL=llama-3.3-70b-versatile
# GROQ_EVALUATION_MODEL=llama-3.3-70b-versatile
# OPENROUTER_EXECUTION_MODEL=openrouter/free
# OPENROUTER_EVALUATION_MODEL=openrouter/free

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database
DATABASE_URL=

# App URL (used for OpenRouter referrer header + OG metadata)
NEXT_PUBLIC_APP_URL=https://gitforprompts.vercel.app
NEXT_PUBLIC_BASE_URL=https://gitforprompts.vercel.app

# Rate Limiting (Upstash Redis — optional in dev, required in production)
# Falls back to in-process limiter when not configured.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cron Auth (required — cron endpoints reject ALL requests without this)
CRON_SECRET=
